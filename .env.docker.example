# Copy to .env before running `docker compose up --build` in non-local environments.
# Replace ALL secret values with strong random credentials before deploying.

SPRING_PROFILES_ACTIVE=dev
MYSQL_ROOT_PASSWORD=replace-with-strong-root-password
DB_USERNAME=globalrfq_app
DB_PASSWORD=replace-with-strong-db-password
RFQ_DB_USERNAME=globalrfq_app
RFQ_DB_PASSWORD=replace-with-strong-db-password

EUREKA_USERNAME=eureka
EUREKA_PASSWORD=replace-with-strong-eureka-password

# Must decode to >= 32 bytes in base64
JWT_SECRET=c29tZS1sb25nLWRldi1vbmx5LWJhc2U2NC1qd3Qtc2VjcmV0LWZvci1sb2NhbC1kb2NrZXI=
GATEWAY_SHARED_SECRET=replace-with-at-least-32-character-gateway-secret
IDENTITY_INTERNAL_SHARED_SECRET=replace-with-at-least-32-character-internal-secret
OUTBOX_ENCRYPTION_KEY=replace-with-at-least-32-character-outbox-key
RFQ_ATTACHMENT_SCANNER_TOKEN=replace-with-at-least-32-character-scanner-token

BOOTSTRAP_ADMIN_EMAIL=admin@globalrfq.local
BOOTSTRAP_ADMIN_NAME=System Administrator
BOOTSTRAP_ADMIN_PASSWORD=ReplaceWithStrongPassword@2026!

CORS_ALLOWED_ORIGINS=http://localhost:5173
FRONTEND_BASE_URL=http://localhost:5173
VITE_API_BASE_URL=http://localhost:8080
VITE_DEMO_MODE=false
COOKIE_SECURE=false
TRUSTED_PROXY_COUNT=1
RFQ_DEFAULT_TIME_ZONE=Asia/Kolkata

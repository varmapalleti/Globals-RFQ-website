SERVER_PORT=8082
SPRING_PROFILES_ACTIVE=dev
RFQ_DB_URL=jdbc:mysql://localhost:3306/global_rfq?useSSL=true&serverTimezone=UTC
RFQ_DB_USERNAME=global_rfq_app
RFQ_DB_PASSWORD=replace-with-local-secret
GATEWAY_SHARED_SECRET=replace-with-the-same-secret-used-by-api-gateway
IDENTITY_INTERNAL_SHARED_SECRET=replace-with-a-separate-rfq-to-identity-secret
EUREKA_USERNAME=eureka
EUREKA_PASSWORD=local-eureka-password-change-me
EUREKA_SERVER_URL=http://eureka:local-eureka-password-change-me@localhost:8761/eureka/
RFQ_STORAGE_DIR=./data/rfq-files
RFQ_STORAGE_PROVIDER=local
AWS_REGION=ap-south-1
RFQ_S3_BUCKET=replace-with-private-rfq-bucket
RFQ_S3_PREFIX=global-rfq
RFQ_DEFAULT_TIME_ZONE=Asia/Kolkata
RFQ_ATTACHMENT_SCANNER_TOKEN=replace-with-a-random-secret-of-at-least-32-characters
RFQ_MAX_FILE_SIZE=25MB
RFQ_MAX_REQUEST_SIZE=30MB
RFQ_MAX_ATTACHMENT_SIZE_BYTES=26214400
RFQ_IMPORT_PREVIEW_TTL_MINUTES=30
